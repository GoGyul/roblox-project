-- 💬 수다 주제 모음
--
-- 동료에게 "수다 떨기"를 하면 주제 하나를 골라 대화가 이어져요.
--   - who가 없으면 누구와도 나오는 공통 주제, 있으면 그 동료 전용 주제예요.
--   - 줄이 "> "로 시작하면 내(플레이어) 대사, 아니면 동료 대사예요.
--   - 대화를 끝까지 하면 수다 도감에 주제가 기록돼요.
--
-- 🗣️ 맞장구 고르기: 줄 대신 아래처럼 표를 넣으면 화면에 보기 3개가 떠요 ([1]·[2]·[3], 4초)
--   { react = { "보기1", "보기2", "보기3" }, good = 좋은 대답 번호, bad = 눈치 없는 대답 번호 }
--   - 나머지 하나는 그냥 무난한 대답이에요.
--   - sulk = "…" 를 넣으면 눈치 없는 대답을 골랐을 때 동료가 그 말을 하고 삐져요 (없으면 아래 SulkLines에서 골라요)
--   - yay = "…" 를 넣으면 좋은 대답을 골랐을 때 동료가 그 말을 해요 (없으면 GoodReplies)
--   - 보기 순서는 서버가 섞어서 보여 줘요.
--
-- 주제를 늘리고 싶으면 아래 목록에 하나씩 추가하면 돼요! (id는 한 번 정하면 바꾸지 마세요: 도감 기록이 id로 저장돼요)

export type Reaction = {
	react: { string },
	good: number,
	bad: number,
	sulk: string?,
	yay: string?,
}

export type Topic = {
	id: string,
	title: string,
	who: string?,
	lines: { any }, -- string 또는 Reaction
}

