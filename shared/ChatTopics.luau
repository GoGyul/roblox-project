-- 이 동료와 나눌 주제 고르기 (최대한 안 겹치게)
--   1. 아직 안 들어 본 주제 중에서 (전용 주제를 2배 자주)
--   2. 다 들었으면 최근에 한 주제(recent)는 빼고
--   recent: 최근에 고른 주제 id 목록 (Employees가 플레이어마다 들고 있어요)
function ChatTopics.pick(coworkerName: string, heard: { [string]: boolean }, recent: { string }?): Topic
	local fresh, notRecent, all = {}, {}, {}
	for _, topic in ChatTopics.Topics do
		if topic.who == nil or topic.who == coworkerName then
			local weight = if topic.who then 2 else 1
			local isRecent = recent ~= nil and table.find(recent, topic.id) ~= nil
			for _ = 1, weight do
				table.insert(all, topic)
				if not isRecent then
					table.insert(notRecent, topic)
					if not heard[`chat_{topic.id}`] then
						table.insert(fresh, topic)
					end
				end
			end
		end
	end
	local pool = if #fresh > 0 then fresh elseif #notRecent > 0 then notRecent else all
	return pool[math.random(1, #pool)]
end

-- 이 줄이 🗣️ 맞장구 고르기인가?
function ChatTopics.isReaction(line: any): boolean
	return typeof(line) == "table" and typeof(line.react) == "table"
end

function ChatTopics.isPlayerLine(line: string): boolean
	return string.sub(line, 1, 2) == "> "
end

function ChatTopics.stripPlayer(line: string): string
	return string.sub(line, 3)
end

return ChatTopics
